# =============================================
# Data2Pro Backend — Environment Variables
# Copy this file to .env and fill in the values
# =============================================

# Server Port (Railway will inject PORT automatically)
PORT=5000

# Supabase Configuration (Service Role Key — KEEP SECRET, never expose to frontend)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_KEY=your-supabase-service-role-key

# Google Gemini API Key (from https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your-gemini-api-key

# Allowed CORS Origins (comma-separated list of allowed frontend URLs)
# Add your Vercel production domain here after deployment
# Example: https://data2pro.vercel.app,chrome-extension://pcbpgghengakafkklhljpndjpajgjphc
ALLOWED_ORIGINS=https://your-frontend.vercel.app,chrome-extension://your-extension-id
