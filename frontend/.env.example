# =============================================
# Data2Pro Frontend — Environment Variables
# Copy this file to .env.local and fill in the values
# =============================================

# Supabase Client Configuration (SAFE to expose — anon key only)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Backend Service URL (Railway production URL after deploy)
NEXT_PUBLIC_BACKEND_URL=https://your-backend.railway.app

# Your Vercel frontend domain (used for auth email redirects)
NEXT_PUBLIC_SITE_URL=https://your-app.vercel.app
