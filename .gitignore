node_modules/
*/node_modules/

# Next.js build output
.next/
*/.next/
out/
*/out/
dist/
*/dist/
build/
*/build/

# Environment files — NEVER commit these
.env
.env.local
.env.development
.env.production
.env.development.local
.env.test.local
.env.production.local
